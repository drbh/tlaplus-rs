// Port of Operators.tla: the same constant facts, checked before exploration.
// Sequences retain TLA+'s one-based indexing. (1, true) is a mixed tuple.
// Run: tla examples/02-operators/Operators.tsl
// Expect: Safety checks passed.
spec Operators {
    const s: Seq<String> = ["a"];
    fn minutes_to_seconds(m: Int) -> Int { m * 60 }
    fn absolute(n: Int) -> Int { if n < 0 { -n } else { n } }
    fn xor(a: Bool, b: Bool) -> Bool { a == !b }
    fn range_of(values: Seq<Int>) -> Set<Int> {
        set_of(i in 1..=len(values)) { values[i] }
    }
    fn to_seconds(t: Seq<Int>) -> Int { t[1] * 3600 + t[2] * 60 + t[3] }
    fn to_clock(seconds: Int) -> Seq<Int> {
        choose(t in product3(0..=23, 0..=59, 0..=59)) {
            to_seconds(t) == seconds % 86400
        }
    }
    assume minutes_to_seconds(2) == 120;
    assume absolute(-3) == 3;
    assume xor(true, false) && !xor(true, true);
    assume (false => true) && ((true => false) == false);
    assume append(s, "b") == ["a", "b"];
    assume concat(s, ["b", "c"]) == ["a", "b", "c"];
    assume head([1, 2, 3]) == 1 && tail([1, 2, 3]) == [2, 3];
    assume len(s) == 1 && slice([1, 3, 5], 1, 2) == [1, 3];
    assume contains({1, 2, 3}, 2) && !contains({1, 2, 3}, 4);
    assume union({1, 2}, {2, 3}) == {1, 2, 3};
    assume intersect({1, 2}, {2, 3}) == {2};
    assume difference({1, 2, 3}, {2}) == {1, 3};
    assume subset({1, 2}, {1, 2, 3}) && size({1, 2, 3}) == 3;
    assume (1..=3) == {1, 2, 3} && (3..=1) == {};
    assume set_of(n in 1..=4) { n * n } == {1, 4, 9, 16};
    assume filter(n in 1..=4) { n % 2 == 0 } == {2, 4};
    assume contains(product(1..=2, {true, false}), (1, true));
    assume powerset({1, 2}) == {{}, {1}, {2}, {1, 2}};
    assume range_of([3, 1, 3]) == {1, 3};
    assume forall(n in 1..=5) { n > 0 };
    assume exists(n in 1..=5) { n == 3 };
    assume forall(n in 1..=0) { false };
    assume to_clock(3661) == [1, 1, 1];
    state unused: Int = 0;
    action stay {}
    next { stay }
}
