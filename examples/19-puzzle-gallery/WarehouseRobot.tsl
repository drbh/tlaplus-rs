// A 4x4 warehouse, with a wall at (2,3). Push the crate from (2,2) to (3,3).
// The robot starts at (1,2). It may walk or push one square, but never pull.
// NotSolved reveals a shortest plan; pushing into a corner can be irreversible.
spec WarehouseRobot {
    struct Position { x: Int, y: Int }
    enum Direction { Up, Down, Left, Right }
    type Floor = Position where p {
        p.x >= 1 && p.x <= 4 && p.y >= 1 && p.y <= 4 && !(p.x == 2 && p.y == 3)
    }
    fn adjacent(p: Position, direction: Direction) -> Position {
        Position {
            x: p.x + (if direction == Left { -1 } else { if direction == Right { 1 } else { 0 } }),
            y: p.y + (if direction == Up { -1 } else { if direction == Down { 1 } else { 0 } })
        }
    }
    state robot: Floor = Position { x: 1, y: 2 };
    state crate: Floor = Position { x: 2, y: 2 };
    view solved() -> Bool { crate == Position { x: 3, y: 3 } }
    action walk(direction in Direction) {
        require adjacent(robot, direction) is Floor;
        require adjacent(robot, direction) != crate;
        next robot = adjacent(robot, direction);
    }
    action push(direction in Direction) {
        require adjacent(robot, direction) == crate;
        require adjacent(crate, direction) is Floor;
        next robot = crate;
        next crate = adjacent(crate, direction);
    }
    action inspect {}
    next { walk, push, inspect }
    invariant Separate { robot != crate }
    invariant NotSolved { !solved() }
}
