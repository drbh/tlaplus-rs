// Modern-syntax port of Counter.tla in this directory.
// Same state machine: 0 -> 1 -> 2 -> 3 -> 0.
//
// The modulo expression directly mirrors the original atomic step.
//
// Run:    tla examples/01-counter/Counter.tsl
// Expect: 4 distinct states found (1 initial), search depth 4
//         Safety checks passed
spec Counter {
    state x: Int = 0;

    action increment {
        next x = (x + 1) % 4;
    }

    // TypeOK is generated by the DSL; this is the original range invariant.
    invariant InRange { x >= 0 && x <= 3 }
    next { increment }
}
