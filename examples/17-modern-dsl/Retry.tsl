// A request may be lost and retried indefinitely.
// Strong fairness on delivery excludes losing every attempt forever.
// Expected: DeliveredEventually passes.
spec Retry {
    state pending: Bool = false;
    state delivered: Bool = false;
    // Inline composition keeps loss/delivery atomic with clearing the request.
    action clear_pending {
        require pending;
        next pending = false;
    }
    action send {
        require !pending && !delivered;
        next pending = true;
    }
    action lose {
        call clear_pending();
    }
    action deliver {
        call clear_pending();
        next delivered = true;
    }
    action finished { require delivered; }
    fair weak send;
    fair strong deliver;
    invariant NoDuplicateRequest { delivered => !pending }
    property DeliveredEventually { eventually(delivered) }
    next { send, lose, deliver, finished }
}
