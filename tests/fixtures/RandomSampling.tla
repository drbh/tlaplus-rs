SubsetEmptyProduct(unused) == RandomSubset(12, (1..4000) \X {})
SubsetEmptyFunction(unused) == RandomSubset(12, [{} -> {}])
SubsetZeroBig(unused) == RandomSubset(0, [1..150 -> {5, 1}])
SubsetBadCount(unused) == RandomSubset(TRUE, {RandomElement(1..1000000)})
SubsetNegative(unused) == RandomSubset(-1, 1..100)
SubsetMaxInterval(unused) == RandomSubset(1, 1..2147483647)
UnionDomainFunction(unused) == [n \in {3, 1} \cup {2, 1} |-> RandomElement(1..1000000)]
PrintUnionFunction(unused) == PrintT([n \in UNION {{3, 1}, {2, 1}} |-> RandomElement(1..1000000)])
