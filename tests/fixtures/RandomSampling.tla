EmptyFunction(unused) == RandomElement([{} -> {}])
NestedDraw(unused) == RandomElement({RandomElement(1..1000000)})
BadProduct(unused) == RandomElement((1..100) \X {1, TRUE})
BadFunction(unused) == RandomElement([{} -> {1, TRUE}])
SubsetInterval(unused) == RandomSubset(12, 1..100000000)
