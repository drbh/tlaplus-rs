{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "comment",
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|[0-9]+",
  "indentationRules": {
    "increaseIndentPattern": "^[^/]*[({\\[][^)}\\]]*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*[)}\\]]"
  }
}
